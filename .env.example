# ============================================================================
# Portal Espiritual — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local — it's git-ignored.
# All variables are required unless marked OPTIONAL.
# ============================================================================

# ---- Site ------------------------------------------------------------------
# Local dev server URL. Used for Stripe Checkout success/cancel redirects
# and magic-link URLs in emails.
APP_URL=http://localhost:3000

# Public-facing canonical URL (production). Used for SEO / og-tags.
NEXT_PUBLIC_SITE_URL=https://portalespiritual.com.mx

# ---- Stripe (TEST MODE until pre-launch S10) -------------------------------
# Get from: Stripe Dashboard → Developers → API keys
# Test mode keys start with pk_test_ / sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Get from: Stripe Dashboard → Products → Mentoría 1-a-1 → Pricing → price_xxx
# Created manually as part of S1 Task 1.5 (recurring monthly, 2222 MXN)
STRIPE_PRICE_ID_MENTORIA=price_REPLACE_ME

# Get from: run `stripe listen --forward-to http://localhost:3000/api/webhooks/stripe`
# Stripe CLI prints the whsec_... when it starts forwarding.
# In production: Stripe Dashboard → Developers → Webhooks → endpoint signing secret.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ---- Resend ----------------------------------------------------------------
# Get from: Resend dashboard → API Keys
RESEND_API_KEY=re_REPLACE_ME

# Verified sender on portalespiritual.com.mx domain
RESEND_FROM_EMAIL=hola@portalespiritual.com.mx

# OPTIONAL — Where to BCC operational notifications (new subscriber alerts, etc.)
CLIENT_NOTIFICATION_EMAIL=akasha.infinito8@gmail.com

# ---- Database (Neon via Vercel) --------------------------------------------
# Get from: Vercel project → Storage → Neon → .env tab
# DATABASE_URL uses the pooled connection (for app runtime)
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require

# Unpooled connection — used by Drizzle Kit for migrations
DATABASE_URL_UNPOOLED=postgresql://user:pass@host.region.aws.neon.tech/db?sslmode=require

# ---- Auth ------------------------------------------------------------------
# 32+ character random hex secret for signing magic-link tokens.
# Generate with: openssl rand -hex 32
MAGIC_LINK_SECRET=REPLACE_ME_WITH_32_BYTE_HEX

# ---- Admin (OPTIONAL) ------------------------------------------------------
# Email of the initial admin user, seeded by migration in S10.
# If unset, admin must be promoted manually via SQL.
ADMIN_SEED_EMAIL=